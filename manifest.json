{
  "manifest_version": 3,
  "name": "Tab Switcher",
  "version": "0.2.0",
  "description": "Tab list with fuzzy search and Vim keybindings.",
  "permissions": ["tabs", "sessions", "storage"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "toggle-switcher": {
      "suggested_key": {
        "default": "Alt+Space"
      },
      "description": "Open/close Tab Switcher"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-switcher@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
